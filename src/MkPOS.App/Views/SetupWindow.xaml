<Window x:Class="MKPOS.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKPOS Lite - Configuración inicial"
        Height="720" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F5F6FA">

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,24,40,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Configuración inicial"
                       HorizontalAlignment="Center"
                       FontSize="26" FontWeight="Bold"
                       Foreground="#1F3864"/>
            <TextBlock Grid.Row="1" Text="Esta configuración se realiza solo la primera vez."
                       HorizontalAlignment="Center" Margin="0,2,0,20"
                       Foreground="#6B7280"/>

            <TextBlock Grid.Row="2" Text="Datos de la empresa"
                       FontWeight="SemiBold" FontSize="15"
                       Foreground="#1F3864" Margin="0,4,0,8"/>

            <TextBlock Grid.Row="3" Text="Nombre comercial *" Foreground="#374151"/>
            <TextBox Grid.Row="4" Margin="0,4,0,10" Padding="8,6"
                     BorderBrush="#CBD5E1" BorderThickness="1"
                     Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="5" Text="RFC / Identificación fiscal" Foreground="#374151"/>
            <TextBox Grid.Row="6" Margin="0,4,0,10" Padding="8,6"
                     BorderBrush="#CBD5E1" BorderThickness="1"
                     Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="7" Text="Dirección" Foreground="#374151"/>
            <TextBox Grid.Row="8" Margin="0,4,0,10" Padding="8,6"
                     BorderBrush="#CBD5E1" BorderThickness="1"
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="9" Text="Teléfono" Foreground="#374151"/>
            <TextBox Grid.Row="10" Margin="0,4,0,10" Padding="8,6"
                     BorderBrush="#CBD5E1" BorderThickness="1"
                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="11" Text="Correo electrónico" Foreground="#374151"/>
            <TextBox Grid.Row="12" Margin="0,4,0,10" Padding="8,6"
                     BorderBrush="#CBD5E1" BorderThickness="1"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Grid.Row="13" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Símbolo de moneda" Foreground="#374151"/>
                    <TextBox Margin="0,4,0,0" Padding="8,6"
                             BorderBrush="#CBD5E1" BorderThickness="1"
                             Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tasa de impuesto (%)" Foreground="#374151"/>
                    <TextBox Margin="0,4,0,0" Padding="8,6"
                             BorderBrush="#CBD5E1" BorderThickness="1"
                             Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="14" Text="Pie de impresión (recibos)" Foreground="#374151"/>
            <TextBox Grid.Row="15" Margin="0,4,0,18" Padding="8,6"
                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                     BorderBrush="#CBD5E1" BorderThickness="1"
                     Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="16" Text="Cuenta de administrador"
                       FontWeight="SemiBold" FontSize="15"
                       Foreground="#1F3864" Margin="0,4,0,8"/>

            <TextBlock Grid.Row="17" Text="Nombre de usuario *" Foreground="#374151"/>
            <TextBox Grid.Row="18" Margin="0,4,0,10" Padding="8,6"
                     BorderBrush="#CBD5E1" BorderThickness="1"
                     Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="19" Text="Nombre para mostrar" Foreground="#374151"/>
            <TextBox Grid.Row="20" Margin="0,4,0,10" Padding="8,6"
                     BorderBrush="#CBD5E1" BorderThickness="1"
                     Text="{Binding AdminDisplayName, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Grid.Row="21" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Contraseña *" Foreground="#374151"/>
                    <PasswordBox x:Name="AdminPasswordBox" Margin="0,4,0,0" Padding="8,6"
                                 BorderBrush="#CBD5E1" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Confirmar contraseña *" Foreground="#374151"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,0" Padding="8,6"
                                 BorderBrush="#CBD5E1" BorderThickness="1"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="22" Text="{Binding ErrorMessage}"
                       Foreground="#DC2626" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyToVisibility}}"/>
        </Grid>
    </ScrollViewer>

    <Grid Grid.Row="1" Margin="40,12,40,26">
        <Button x:Name="CompleteButton" Content="Guardar configuración"
                Height="40" FontSize="14" FontWeight="SemiBold"
                Foreground="White" Cursor="Hand" IsDefault="True"
                Command="{Binding CompleteSetupCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#1F3864"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#16294B"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#9CA3AF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
    </Grid>
</Window>