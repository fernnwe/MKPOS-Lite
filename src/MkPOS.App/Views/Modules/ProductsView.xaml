<UserControl x:Class="MKPOS.App.Views.Modules.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MKPOS.App.Converters">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Nuevo producto" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewCommand}"/>
                    <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Command="{Binding EditCommand}"/>
                    <Button Content="Desactivar / Activar" Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0" Command="{Binding DeleteCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Mostrar inactivos" VerticalAlignment="Center" Margin="0,0,10,0"
                              IsChecked="{Binding IncludeInactive}"/>
                    <TextBox Width="220" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Buscar por nombre, código o código de barras"/>
                    <Button Content="Buscar" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" Command="{Binding SearchCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lista de productos -->
        <DataGrid Grid.Row="1" Style="{StaticResource ModuleTableStyle}"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedRow}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="110"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryName}" Width="130"/>
                <DataGridTextColumn Header="Costo" Binding="{Binding PurchasePrice, StringFormat={}{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding SalePrice, StringFormat={}{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="IVA %" Binding="{Binding TaxRate, StringFormat={}{0:N2}}" Width="70"/>
                <DataGridTextColumn Header="Existencia" Binding="{Binding Stock, StringFormat={}{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="Mínimo" Binding="{Binding MinStock, StringFormat={}{0:N2}}" Width="80"/>
                <DataGridTextColumn Header="Estado" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="IsActive">
                            <Binding.Converter>
                                <local:BoolToTextConverter TrueText="Activo" FalseText="Inactivo"/>
                            </Binding.Converter>
                        </Binding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Editor de producto -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,10,0,0"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#1F3864" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Código (SKU)" Foreground="#374151"/>
                        <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Nombre" Foreground="#374151"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Categoría" Foreground="#374151"/>
                        <ComboBox ItemsSource="{Binding CategoryOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedCategoryOption}"
                                  Padding="6,4"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Código de barras" Foreground="#374151"/>
                        <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Precio de compra" Foreground="#374151"/>
                        <TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Precio de venta" Foreground="#374151"/>
                        <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Impuesto % (vacío = empresa)" Foreground="#374151"/>
                        <TextBox Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Existencia inicial" Foreground="#374151"/>
                        <TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Nivel mínimo" Foreground="#374151"/>
                        <TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                        <CheckBox Content="Producto activo" IsChecked="{Binding EditorIsActive}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelEditCommand}"/>
                        <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyToVisibility}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>