<UserControl x:Class="MKPOS.App.Views.Modules.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filtro por período -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Desde" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Width="130" SelectedDate="{Binding FromDate}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Hasta" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Width="130" SelectedDate="{Binding ToDate}"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Actualizar" Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,0,0"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyToVisibility}}"/>

                <TextBlock Grid.Column="5" Text="Generando..." Foreground="#6B7280" VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- Tarjetas de resumen -->
        <UniformGrid Grid.Row="1" Margin="0,0,0,10" Columns="5">
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Tickets" Foreground="#6B7280" FontSize="12"/>
                    <TextBlock Text="{Binding TotalTickets}" Foreground="#1F3864" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Canceladas" Foreground="#6B7280" FontSize="12"/>
                    <TextBlock Text="{Binding CancelledTickets}" Foreground="#B91C1C" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Subtotal" Foreground="#6B7280" FontSize="12"/>
                    <TextBlock Text="{Binding Subtotal, StringFormat={}{0:N2}}" Foreground="#1F3864" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="IVA" Foreground="#6B7280" FontSize="12"/>
                    <TextBlock Text="{Binding TaxAmount, StringFormat={}{0:N2}}" Foreground="#1F3864" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Total" Foreground="#6B7280" FontSize="12"/>
                    <TextBlock Text="{Binding Total, StringFormat={}{0:N2}}" Foreground="#15803D" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Pestañas de reportes -->
        <TabControl Grid.Row="2" Background="White">
            <TabItem Header="Por día">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Content="Exportar CSV" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportDailyCommand}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource ModuleTableStyle}" ItemsSource="{Binding DailySales}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="*"/>
                            <DataGridTextColumn Header="Tickets" Binding="{Binding Tickets}" Width="150"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Por método de pago">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Content="Exportar CSV" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportByPaymentCommand}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource ModuleTableStyle}" ItemsSource="{Binding SalesByPaymentMethod}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Método de pago" Binding="{Binding PaymentMethodName}" Width="*"/>
                            <DataGridTextColumn Header="Tickets" Binding="{Binding Tickets}" Width="150"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Productos más vendidos">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <TextBlock Text="Top 20" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Exportar CSV" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportTopProductsCommand}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource ModuleTableStyle}" ItemsSource="{Binding TopProducts}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="Ingresos" Binding="{Binding Revenue, StringFormat={}{0:N2}}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Cartera de clientes">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <TextBlock Text="Clientes activos con saldo" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Exportar CSV" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportCustomerBalancesCommand}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource ModuleTableStyle}" ItemsSource="{Binding CustomerBalances}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="160"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyToVisibility}}"/>
    </Grid>
</UserControl>