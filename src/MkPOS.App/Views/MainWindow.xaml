<Window x:Class="MKPOS.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKPOS Lite"
        Height="720" Width="1150"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="960"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F5F6FA">

    <DockPanel>
        <!-- Barra superior -->
        <Border DockPanel.Dock="Top" Background="#1F3864" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MKPOS Lite"
                               Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="|" Foreground="#8FA3C8" Margin="14,0"/>
                    <TextBlock Text="{Binding CompanyName}"
                               Foreground="#D9E2F3" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserDisplay}"
                               Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Cerrar sesión"
                            Padding="10,4" Cursor="Hand"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource HeaderButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Menú lateral -->
        <Border DockPanel.Dock="Left" Background="#FFFFFF" Width="220"
                BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,16">
                <Button Content="Punto de venta" Style="{StaticResource NavButtonStyle}" IsEnabled="False"/>
                <Button Content="Productos" Style="{StaticResource NavButtonStyle}" Command="{Binding GoToProductsCommand}"/>
                <Button Content="Categorías" Style="{StaticResource NavButtonStyle}" Command="{Binding GoToCategoriesCommand}"/>
                <Button Content="Inventario" Style="{StaticResource NavButtonStyle}" Command="{Binding GoToInventoryCommand}"/>
                <Button Content="Ventas" Style="{StaticResource NavButtonStyle}" IsEnabled="False"/>
                <Button Content="Cliente" Style="{StaticResource NavButtonStyle}" IsEnabled="False"/>
                <Button Content="Reportes" Style="{StaticResource NavButtonStyle}" IsEnabled="False"/>
                <Button Content="Configuración" Style="{StaticResource NavButtonStyle}" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <!-- Contenido del módulo -->
        <ContentControl Content="{Binding CurrentModule}" Margin="20,16,20,20"/>
    </DockPanel>
</Window>